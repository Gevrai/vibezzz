		"test:watch": "vitest",
		"lint": "svelte-check --tsconfig ./tsconfig.json"
	},
	"devDependencies": {
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.1.8",
		"@types/bun": "^1.3.10",
		"svelte": "^5.51.0",
		"svelte-adapter-bun": "^0.5.2",
		"svelte-check": "^4.4.2",
		"tailwindcss": "^4.1.8",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"vitest": "^3.2.1"
	},
	"dependencies": {
		"yaml": "^2.7.1"
	}
}
